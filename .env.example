# ==============================================================================
# ApplyTrack Environment Variables Template
# Copy this file to .env and configure your local values. Never commit .env.
# ==============================================================================

# Application Metadata & Runtime Environment
APP_NAME=ApplyTrack
ENVIRONMENT=development

# Database Configuration (PostgreSQL connection string)
# Format: postgresql+psycopg://username:password@host:port/database_name
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/applytrack_dev

# Cryptographic Secret Key for session signing & CSRF protection
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-strong-random-secret-key-in-production
